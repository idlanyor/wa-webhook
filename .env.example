PORT=8181
# "production" makes the login cookie HTTPS-only: use it when served over HTTPS
# (e.g. behind Cloudflare); keep "development" for plain-HTTP access.
NODE_ENV=development
SESSION_SECRET=your-secret-key-change-this

# SQLite database files (created automatically; migrations run on startup)
SQLITE_PATH=./data/wa-webhook.db
ZAPO_SQLITE_PATH=./data/wa-session.db

# Proxies trusted for X-Forwarded-For (real client IP for rate limiting).
# Default: loopback + private networks + Cloudflare ranges. Accepts "false",
# a hop count, or a comma-separated list of IPs/CIDRs.
# TRUST_PROXY=

# Only for the one-off `npm run db:migrate-mongo` (copy data from an old MongoDB install)
# MONGODB_URI=mongodb://localhost:27017/whatsapp-webhook
