PORT=8181
NODE_ENV=development
SESSION_SECRET=your-secret-key-change-this

# SQLite database files (created automatically; migrations run on startup)
SQLITE_PATH=./data/wa-webhook.db
ZAPO_SQLITE_PATH=./data/wa-session.db

# Only for the one-off `npm run db:migrate-mongo` (copy data from an old MongoDB install)
# MONGODB_URI=mongodb://localhost:27017/whatsapp-webhook
