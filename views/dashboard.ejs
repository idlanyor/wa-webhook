<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Dasbor' }) %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.2/socket.io.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
        integrity="sha512-CNgIRecGo7nphbeZ04Sc13ka07paqdeTu0WR1IM4kNcpmBAUSHSQX0FslNhTDadL4O5SAGapGt4FodqL8My0mA=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</head>
<body>
<%- include('partials/shell-start', { title: 'Dasbor', page: 'dashboard' }) %>

    <!-- Session strip -->
    <section class="card mb-4" aria-label="Sesi WhatsApp">
        <div class="flex flex-col gap-3 p-4 md:flex-row md:items-center">
            <div class="flex min-w-0 flex-1 items-center gap-3">
                <span class="avatar h-10 w-10 text-lg"><i id="statusIcon" class="ri-whatsapp-line"></i></span>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <span id="statusIndicator" class="dot disconnected"></span>
                        <span id="connectionStatus" class="text-sm font-bold text-ink">Menghubungkan…</span>
                        <span class="text-muted">·</span>
                        <span id="activePhone" class="truncate font-mono text-[13px] text-ink-soft">Menunggu sesi</span>
                    </div>
                    <div class="mt-0.5 flex items-center gap-2 text-xs text-muted">
                        <span id="activeProfileName" class="truncate">Belum terhubung</span>
                        <span>·</span>
                        <span id="socketStatus" class="font-mono">Socket: …</span>
                    </div>
                </div>
            </div>
            <div class="flex flex-wrap gap-2">
                <button type="button" class="btn btn-secondary btn-sm" id="refreshBtn">
                    <span id="refreshText"><i class="ri-refresh-line"></i> Segarkan</span>
                </button>
                <button type="button" class="btn btn-warning btn-sm" id="resetSessionBtn">
                    <i class="ri-restart-line"></i> Reset sesi
                </button>
                <button type="button" class="btn btn-primary btn-sm" id="testBtn" onclick="testMessage()" disabled>
                    <i class="ri-send-plane-line"></i> Kirim uji
                </button>
                <button type="button" class="btn btn-danger btn-sm" id="waLogoutBtn" onclick="waLogout()" disabled>
                    <i class="ri-logout-circle-r-line"></i> Keluar WA
                </button>
            </div>
        </div>
        <div id="actionStatus" class="alert alert-info mx-4 mb-4" role="status" hidden>
            <i class="ri-loader-4-line spin"></i><span id="actionStatusText">Memproses…</span>
        </div>
    </section>

    <!-- Stats -->
    <section class="mb-4 grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Ringkasan">
        <div class="stat">
            <div class="stat-label">Pesan sesi ini</div>
            <div class="stat-value" id="messageCount">0</div>
            <div class="stat-meta">Masuk sejak halaman dibuka</div>
        </div>
        <div class="stat">
            <div class="stat-label">Uptime sesi</div>
            <div class="stat-value font-mono" id="uptime">--</div>
            <div class="stat-meta" id="uptimeSince">Belum terhubung</div>
        </div>
        <div class="stat">
            <div class="stat-label">Mesin</div>
            <div class="stat-value">zapo</div>
            <div class="stat-meta">Multi-device</div>
        </div>
        <div class="stat">
            <div class="stat-label">Integrasi</div>
            <div class="stat-value">REST API</div>
            <div class="stat-meta"><a href="/api-keys">Kelola kunci</a> · webhook</div>
        </div>
    </section>

    <!-- Connect panel (shown when not connected) -->
    <%- include('partials/qr-container') %>

    <div class="grid gap-4 lg:grid-cols-3">
        <%- include('partials/messages') %>
        <%- include('partials/api-info') %>
    </div>

<%- include('partials/shell-end') %>
<%- include('partials/scripts') %>
</body>
</html>
