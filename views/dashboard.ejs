<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <!-- Content Wrapper -->
    <div class="content-wrapper">
        <!-- Content Header -->
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">Dasbor</h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item active">Dasbor</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">

                <!-- Status Info Boxes -->
                <%- include('partials/status-card') %>

                <div class="row">
                    <!-- Left Column: 2/3 -->
                    <div class="col-lg-8">

                        <!-- QR / Connection Card -->
                        <div class="fade-in">
                            <%- include('partials/qr-container') %>
                        </div>

                        <!-- Live Messages -->
                        <div class="fade-in">
                            <%- include('partials/messages') %>
                        </div>

                    </div>

                    <!-- Right Column: 1/3 -->
                    <div class="col-lg-4">

                        <!-- Quick Actions -->
                        <div class="fade-in">
                            <%- include('partials/actions') %>
                        </div>

                        <!-- API Info -->
                        <div class="fade-in">
                            <%- include('partials/api-info') %>
                        </div>

                    </div>
                </div>

            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="main-footer">
        <strong>WhatsApp Webhook</strong> &copy; 2024.
        <div class="float-right d-none d-sm-inline-block">
            <b>Version</b> 1.0.0
        </div>
    </footer>

</div>

<%- include('partials/bottom-nav') %>
<%- include('partials/scripts') %>
</body>
</html>