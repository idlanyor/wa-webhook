<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Pesan Terjadwal' }) %>
</head>
<body>
<%- include('partials/shell-start', { title: 'Pesan Terjadwal', page: 'scheduled-messages' }) %>
<%
    const statusMap = {
        pending:   { label: 'Pending',  tone: 'badge-warning', icon: 'ri-time-line' },
        sent:      { label: 'Terkirim', tone: 'badge-success', icon: 'ri-check-line' },
        failed:    { label: 'Gagal',    tone: 'badge-danger',  icon: 'ri-close-line' },
        cancelled: { label: 'Dibatal',  tone: 'badge-neutral', icon: 'ri-forbid-line' }
    };
    const statCards = [
        ['Total', stats.total, ''], ['Pending', stats.pending, 'text-warning'], ['Terkirim', stats.sent, 'text-success'],
        ['Gagal', stats.failed, 'text-danger'], ['Dibatal', stats.cancelled, 'text-muted']
    ];
%>

    <div class="page-head">
        <div>
            <h1 class="page-title">Pesan Terjadwal</h1>
            <p class="page-sub m-0">Kirim pesan otomatis pada waktu tertentu.</p>
        </div>
        <button type="button" onclick="showCreateDialog()" class="btn btn-primary"><i class="ri-add-line"></i> Buat jadwal</button>
    </div>

    <%- include('partials/flash') %>

    <section class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5" aria-label="Ringkasan">
        <% statCards.forEach(([label, value, tone]) => { %>
        <div class="stat">
            <div class="stat-label"><%= label %></div>
            <div class="stat-value <%= tone %>"><%= value %></div>
        </div>
        <% }) %>
    </section>

    <section class="card" aria-labelledby="schedTitle">
        <div class="card-head"><h2 class="card-title" id="schedTitle"><i class="ri-calendar-schedule-line"></i> Jadwal</h2></div>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th class="w-10">#</th><th>Tujuan</th><th>Pesan</th><th>Jadwal</th><th>Status</th><th class="text-right">Aksi</th></tr></thead>
                <tbody>
                <% if (messages && messages.length > 0) { %>
                    <% messages.forEach((msg, index) => { const st = statusMap[msg.status] || statusMap.cancelled; %>
                    <tr>
                        <td class="text-muted"><%= index + 1 %></td>
                        <td><code class="code"><%= msg.to %></code></td>
                        <td class="max-w-xs truncate text-ink-soft" title="<%= msg.message %>"><%= msg.message %></td>
                        <td class="whitespace-nowrap text-ink-soft"><%= new Date(msg.scheduledAt).toLocaleString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                        <td><span class="badge <%= st.tone %>"><i class="<%= st.icon %>"></i><%= st.label %></span></td>
                        <td class="whitespace-nowrap text-right">
                            <% if (msg.status === 'pending') { %>
                            <form action="/scheduled-messages/cancel/<%= msg.id %>" method="POST" data-confirm="Batalkan pesan terjadwal ini?" class="inline">
                                <button type="submit" class="btn btn-ghost-warning btn-sm btn-icon" aria-label="Batalkan"><i class="ri-forbid-line"></i></button>
                            </form>
                            <% } %>
                            <form action="/scheduled-messages/delete/<%= msg.id %>" method="POST" data-confirm="Hapus pesan terjadwal ini?" class="inline">
                                <button type="submit" class="btn btn-ghost-danger btn-sm btn-icon" aria-label="Hapus"><i class="ri-delete-bin-line"></i></button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="6" class="empty"><i class="ri-calendar-line"></i>Belum ada pesan terjadwal. Klik “Buat jadwal” untuk menambahkan.</td></tr>
                <% } %>
                </tbody>
            </table>
        </div>
    </section>

<%- include('partials/shell-end') %>
<script>
    async function showCreateDialog() {
        // Step 1: Get phone number
        const { value: phoneNumber } = await Swal.fire({
            title: 'Nomor Tujuan',
            input: 'text',
            inputPlaceholder: 'Contoh: 6281234567890',
            showCancelButton: true,
            confirmButtonText: 'Lanjut',
            cancelButtonText: 'Batal',
            confirmButtonColor: '#7c3aed',
            inputValidator: (value) => {
                if (!value) return 'Nomor WhatsApp harus diisi!';
                const cleaned = value.replace(/[^\d+]/g, '');
                if (!/^\+?\d{7,15}$/.test(cleaned)) return 'Format nomor tidak valid!';
            }
        });

        if (!phoneNumber) return;
        let finalPhone = phoneNumber.replace(/[^\d+]/g, '');
        if (finalPhone.startsWith('+')) {
            finalPhone = finalPhone.substring(1);
        } else if (finalPhone.startsWith('0')) {
            finalPhone = '62' + finalPhone.substring(1);
        }

        // Step 2: Get message
        const { value: message } = await Swal.fire({
            title: 'Isi Pesan',
            input: 'textarea',
            inputPlaceholder: 'Ketik pesan Anda...',
            showCancelButton: true,
            confirmButtonText: 'Lanjut',
            cancelButtonText: 'Batal',
            confirmButtonColor: '#7c3aed',
            inputValidator: (value) => {
                if (!value) return 'Pesan tidak boleh kosong!';
            }
        });

        if (!message) return;

        // Step 3: Get scheduled time
        const now = new Date();
        const minDateTime = new Date(now.getTime() + 60000).toISOString().slice(0, 16);

        const { value: scheduledAt } = await Swal.fire({
            title: 'Jadwal Pengiriman',
            html: `
                <div class="text-left">
                    <label class="label" for="scheduledDateTime">Tanggal dan waktu</label>
                    <input type="datetime-local" id="scheduledDateTime" class="input" min="${minDateTime}" required>
                </div>
            `,
            showCancelButton: true,
            confirmButtonText: 'Jadwalkan',
            cancelButtonText: 'Batal',
            confirmButtonColor: '#7c3aed',
            preConfirm: () => {
                const dateTime = document.getElementById('scheduledDateTime').value;
                if (!dateTime) {
                    Swal.showValidationMessage('Tanggal dan waktu harus dipilih!');
                    return false;
                }
                const selectedDate = new Date(dateTime);
                if (selectedDate <= new Date()) {
                    Swal.showValidationMessage('Waktu harus di masa depan!');
                    return false;
                }
                return dateTime;
            }
        });

        if (!scheduledAt) return;

        try {
            const response = await fetch('/scheduled-messages/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ to: finalPhone, message, scheduledAt, messageType: 'text' })
            });

            const result = await response.json();

            if (result.success) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: 'Pesan berhasil dijadwalkan',
                    confirmButtonColor: '#7c3aed'
                });
                window.location.reload();
            } else {
                throw new Error(result.error || 'Gagal menjadwalkan pesan');
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Gagal!',
                text: error.message
            });
        }
    }
</script>
</body>
</html>
