<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Pesan Terjadwal' }) %>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">Pesan Terjadwal</h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item"><a href="/dashboard">Dasbor</a></li>
                            <li class="breadcrumb-item active">Pesan Terjadwal</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">

                <!-- Stats -->
                <div class="row fade-in">
                    <div class="col-6 col-lg">
                        <div class="info-box">
                            <span class="info-box-icon bg-info elevation-1"><i class="ri-calendar-line"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Total</span>
                                <span class="info-box-number"><%= stats.total %></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg">
                        <div class="info-box">
                            <span class="info-box-icon bg-warning elevation-1"><i class="ri-time-line"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Pending</span>
                                <span class="info-box-number"><%= stats.pending %></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg">
                        <div class="info-box">
                            <span class="info-box-icon bg-success elevation-1"><i class="ri-check-line"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Terkirim</span>
                                <span class="info-box-number"><%= stats.sent %></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg">
                        <div class="info-box">
                            <span class="info-box-icon bg-danger elevation-1"><i class="ri-close-line"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Gagal</span>
                                <span class="info-box-number"><%= stats.failed %></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg">
                        <div class="info-box">
                            <span class="info-box-icon bg-secondary elevation-1"><i class="ri-forbid-line"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Dibatal</span>
                                <span class="info-box-number"><%= stats.cancelled %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Alerts -->
                <% if (locals.error) { %>
                <div class="alert alert-danger alert-dismissible fade show fade-in" role="alert">
                    <i class="ri-error-warning-line mr-2"></i> <%= error %>
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
                <% } %>
                <% if (locals.success) { %>
                <div class="alert alert-success alert-dismissible fade show fade-in" role="alert">
                    <i class="ri-checkbox-circle-line mr-2"></i> <%= success %>
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
                <% } %>

                <!-- Messages Table -->
                <div class="card card-outline card-primary fade-in">
                    <div class="card-header">
                        <h3 class="card-title"><i class="ri-calendar-schedule-line text-primary mr-2"></i>Daftar Pesan Terjadwal</h3>
                        <div class="card-tools">
                            <button onclick="showCreateDialog()" class="btn btn-primary btn-sm">
                                <i class="ri-add-line mr-1"></i> Buat Jadwal
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th width="40">No</th>
                                        <th>Tujuan</th>
                                        <th>Pesan</th>
                                        <th>Jadwal</th>
                                        <th>Status</th>
                                        <th class="text-right">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (messages && messages.length > 0) { %>
                                        <% messages.forEach((msg, index) => { %>
                                        <tr>
                                            <td class="text-muted"><%= index + 1 %></td>
                                            <td><code><%= msg.to %></code></td>
                                            <td>
                                                <span title="<%= msg.message %>" style="max-width:200px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                                    <%= msg.message.substring(0, 50) %><% if (msg.message.length > 50) { %>...<% } %>
                                                </span>
                                            </td>
                                            <td style="font-size:0.82rem;">
                                                <%= new Date(msg.scheduledAt).toLocaleString('id-ID', {
                                                    day: '2-digit', month: 'short', year: 'numeric',
                                                    hour: '2-digit', minute: '2-digit'
                                                }) %>
                                            </td>
                                            <td>
                                                <% if (msg.status === 'pending') { %>
                                                    <span class="badge badge-warning p-2" style="border-radius:20px;">
                                                        <i class="ri-time-line mr-1"></i>Pending
                                                    </span>
                                                <% } else if (msg.status === 'sent') { %>
                                                    <span class="badge badge-success p-2" style="border-radius:20px;">
                                                        <i class="ri-check-line mr-1"></i>Terkirim
                                                    </span>
                                                <% } else if (msg.status === 'failed') { %>
                                                    <span class="badge badge-danger p-2" style="border-radius:20px;">
                                                        <i class="ri-close-line mr-1"></i>Gagal
                                                    </span>
                                                <% } else if (msg.status === 'cancelled') { %>
                                                    <span class="badge badge-secondary p-2" style="border-radius:20px;">
                                                        <i class="ri-forbid-line mr-1"></i>Dibatal
                                                    </span>
                                                <% } %>
                                            </td>
                                            <td class="text-right">
                                                <% if (msg.status === 'pending') { %>
                                                <form action="/scheduled-messages/cancel/<%= msg._id %>" method="POST"
                                                      style="display:inline;" data-confirm="Batalkan pesan terjadwal ini?">
                                                    <button type="submit" class="btn btn-sm btn-warning mr-1">
                                                        <i class="ri-forbid-line"></i>
                                                    </button>
                                                </form>
                                                <% } %>
                                                <form action="/scheduled-messages/delete/<%= msg._id %>" method="POST"
                                                      style="display:inline;" data-confirm="Hapus pesan terjadwal ini?">
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="ri-delete-bin-line"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-5">
                                            <i class="ri-calendar-line d-block" style="font-size:2.5rem;margin-bottom:8px;"></i>
                                            Belum ada pesan terjadwal.<br>
                                            <small>Klik "Buat Jadwal" untuk membuat pesan terjadwal baru.</small>
                                        </td>
                                    </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>WhatsApp Webhook</strong> &copy; 2024.
        <div class="float-right d-none d-sm-inline-block"><b>Version</b> 1.0.0</div>
    </footer>
</div>

<%- include('partials/bottom-nav') %>
<%- include('partials/simple-scripts') %>

<script>
    async function showCreateDialog() {
        // Step 1: Get phone number
        const { value: phoneNumber } = await Swal.fire({
            title: 'Nomor Tujuan',
            input: 'text',
            inputPlaceholder: 'Contoh: 6281234567890',
            showCancelButton: true,
            confirmButtonText: 'Lanjut',
            cancelButtonText: 'Batal',
            confirmButtonColor: '#25D366',
            inputValidator: (value) => {
                if (!value) return 'Nomor WhatsApp harus diisi!';
                const cleaned = value.replace(/[^\d+]/g, '');
                if (!/^\+?\d{7,15}$/.test(cleaned)) return 'Format nomor tidak valid!';
            }
        });

        if (!phoneNumber) return;
        let finalPhone = phoneNumber.replace(/[^\d+]/g, '');
        if (finalPhone.startsWith('+')) {
            finalPhone = finalPhone.substring(1);
        } else if (finalPhone.startsWith('0')) {
            finalPhone = '62' + finalPhone.substring(1);
        }

        // Step 2: Get message
        const { value: message } = await Swal.fire({
            title: 'Isi Pesan',
            input: 'textarea',
            inputPlaceholder: 'Ketik pesan Anda...',
            showCancelButton: true,
            confirmButtonText: 'Lanjut',
            cancelButtonText: 'Batal',
            confirmButtonColor: '#25D366',
            inputValidator: (value) => {
                if (!value) return 'Pesan tidak boleh kosong!';
            }
        });

        if (!message) return;

        // Step 3: Get scheduled time
        const now = new Date();
        const minDateTime = new Date(now.getTime() + 60000).toISOString().slice(0, 16);

        const { value: scheduledAt } = await Swal.fire({
            title: 'Jadwal Pengiriman',
            html: `
                <div class="text-left">
                    <label class="form-label">Pilih tanggal dan waktu:</label>
                    <input type="datetime-local" id="scheduledDateTime" class="form-control" min="${minDateTime}" required>
                </div>
            `,
            showCancelButton: true,
            confirmButtonText: 'Jadwalkan',
            cancelButtonText: 'Batal',
            confirmButtonColor: '#25D366',
            preConfirm: () => {
                const dateTime = document.getElementById('scheduledDateTime').value;
                if (!dateTime) {
                    Swal.showValidationMessage('Tanggal dan waktu harus dipilih!');
                    return false;
                }
                const selectedDate = new Date(dateTime);
                if (selectedDate <= new Date()) {
                    Swal.showValidationMessage('Waktu harus di masa depan!');
                    return false;
                }
                return dateTime;
            }
        });

        if (!scheduledAt) return;

        try {
            const response = await fetch('/scheduled-messages/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ to: finalPhone, message, scheduledAt, messageType: 'text' })
            });

            const result = await response.json();

            if (result.success) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: 'Pesan berhasil dijadwalkan',
                    confirmButtonColor: '#25D366'
                });
                window.location.reload();
            } else {
                throw new Error(result.error || 'Gagal menjadwalkan pesan');
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Gagal!',
                text: error.message
            });
        }
    }
</script>
</body>
</html>
