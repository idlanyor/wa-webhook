<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title }) %>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <%- include('partials/sidebar', { page: 'products' }) %>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col lg:ml-64 min-w-0">
            <%- include('partials/navbar', { title: 'Knowledge Base' }) %>

            <!-- Main Scrollable Area -->
            <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8">
                <div class="max-w-7xl mx-auto space-y-6">
                    
                    <!-- Page Header -->
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div>
                            <h1 class="text-2xl font-bold text-gray-900">Knowledge Base</h1>
                            <p class="text-gray-500 mt-1">Kelola data produk untuk referensi AI Customer Service.</p>
                        </div>
                        <div class="flex space-x-3">
                            <button onclick="openColumnModal()" class="flex items-center space-x-2 px-4 py-2 bg-white border border-gray-300 rounded-xl text-gray-700 hover:bg-gray-50 transition-colors shadow-sm">
                                <i class="ri-table-line"></i>
                                <span>Atur Kolom</span>
                            </button>
                            <button onclick="openProductModal()" class="flex items-center space-x-2 px-4 py-2 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-200">
                                <i class="ri-add-line text-lg"></i>
                                <span>Tambah Produk</span>
                            </button>
                        </div>
                    </div>

                    <!-- Products Table -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase text-gray-500 font-semibold tracking-wider">
                                        <th class="px-6 py-4">Nama Produk</th>
                                        <% fields.forEach(field => { %>
                                            <th class="px-6 py-4"><%= field.label %></th>
                                        <% }); %>
                                        <th class="px-6 py-4 text-right">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200 text-sm">
                                    <% if (products.length === 0) { %>
                                        <tr>
                                            <td colspan="<%= fields.length + 2 %>" class="px-6 py-8 text-center text-gray-500">
                                                Belum ada data produk. Mulai dengan menambahkan produk baru.
                                            </td>
                                        </tr>
                                    <% } %>
                                    <% products.forEach(product => { %>
                                        <tr class="hover:bg-gray-50 transition-colors group">
                                            <td class="px-6 py-4 font-medium text-gray-900"><%= product.name %></td>
                                            <% fields.forEach(field => { %>
                                                <td class="px-6 py-4 text-gray-600">
                                                    <% 
                                                        let val = '';
                                                        if (product.data && product.data instanceof Map) {
                                                            val = product.data.get(field.key);
                                                        } else if (product.data) {
                                                            val = product.data[field.key];
                                                        }
                                                    %>
                                                    <%= val || '-' %>
                                                </td>
                                            <% }); %>
                                            <td class="px-6 py-4 text-right space-x-2">
                                                <button onclick="editProduct('<%= product._id %>', '<%= product.name %>', <%= JSON.stringify(product.data) %>)" class="text-blue-600 hover:text-blue-800 p-1 rounded hover:bg-blue-50">
                                                    <i class="ri-pencil-line"></i>
                                                </button>
                                                <button onclick="deleteProduct('<%= product._id %>')" class="text-red-600 hover:text-red-800 p-1 rounded hover:bg-red-50">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Column Manager Modal -->
    <div id="columnModal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-gray-500/75 backdrop-blur-sm transition-opacity" onclick="closeColumnModal()"></div>
        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
                    <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                        <div class="sm:flex sm:items-start">
                            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                                <h3 class="text-lg font-semibold leading-6 text-gray-900" id="modal-title">Atur Kolom Custom</h3>
                                
                                <!-- Existing Fields List -->
                                <div class="mt-4 space-y-2 mb-6">
                                    <p class="text-xs text-gray-500 uppercase font-bold mb-2">Kolom Saat Ini</p>
                                    <div id="fieldsList" class="space-y-2">
                                        <% fields.forEach(field => { %>
                                            <div class="flex justify-between items-center bg-gray-50 p-2 rounded-lg border border-gray-200">
                                                <span class="text-sm font-medium text-gray-700"><%= field.label %> <span class="text-xs text-gray-400">(<%= field.type %>)</span></span>
                                                <button onclick="deleteField('<%= field._id %>')" class="text-red-500 hover:text-red-700 text-sm">
                                                    <i class="ri-close-circle-line"></i>
                                                </button>
                                            </div>
                                        <% }); %>
                                        <% if (fields.length === 0) { %>
                                            <p class="text-sm text-gray-400 italic">Belum ada kolom custom.</p>
                                        <% } %>
                                    </div>
                                </div>

                                <hr class="border-gray-100 my-4">

                                <!-- Add New Field Form -->
                                <form id="addFieldForm" onsubmit="submitField(event)">
                                    <p class="text-xs text-gray-500 uppercase font-bold mb-3">Tambah Kolom Baru</p>
                                    <div class="space-y-3">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Nama Kolom</label>
                                            <input type="text" name="label" required placeholder="Contoh: Stok, Harga, Warna" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2.5 border">
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Tipe Data</label>
                                            <select name="type" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2.5 border">
                                                <option value="text">Teks</option>
                                                <option value="number">Angka</option>
                                                <option value="boolean">Ya/Tidak</option>
                                                <option value="url">Link/URL</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mt-5 sm:flex sm:flex-row-reverse">
                                        <button type="submit" class="inline-flex w-full justify-center rounded-xl bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 sm:ml-3 sm:w-auto">Tambah</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                        <button type="button" onclick="closeColumnModal()" class="mt-3 inline-flex w-full justify-center rounded-xl bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">Tutup</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Modal -->
    <div id="productModal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-gray-500/75 backdrop-blur-sm transition-opacity" onclick="closeProductModal()"></div>
        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
                    <form id="productForm" onsubmit="submitProduct(event)">
                        <input type="hidden" id="productId" name="id">
                        <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                            <div class="sm:flex sm:items-start">
                                <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                                    <h3 class="text-lg font-semibold leading-6 text-gray-900" id="productModalTitle">Tambah Produk</h3>
                                    <div class="mt-4 space-y-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Nama Produk <span class="text-red-500">*</span></label>
                                            <input type="text" name="name" id="productName" required class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2.5 border">
                                        </div>
                                        
                                        <!-- Dynamic Fields -->
                                        <% fields.forEach(field => { %>
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700"><%= field.label %></label>
                                                <% if (field.type === 'number') { %>
                                                    <input type="number" name="<%= field.key %>" id="field_<%= field.key %>" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2.5 border">
                                                <% } else if (field.type === 'boolean') { %>
                                                    <select name="<%= field.key %>" id="field_<%= field.key %>" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2.5 border">
                                                        <option value="">- Pilih -</option>
                                                        <option value="Yes">Ya</option>
                                                        <option value="No">Tidak</option>
                                                    </select>
                                                <% } else { %>
                                                    <input type="text" name="<%= field.key %>" id="field_<%= field.key %>" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2.5 border">
                                                <% } %>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                            <button type="submit" class="inline-flex w-full justify-center rounded-xl bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 sm:ml-3 sm:w-auto">Simpan</button>
                            <button type="button" onclick="closeProductModal()" class="mt-3 inline-flex w-full justify-center rounded-xl bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">Batal</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/simple-scripts') %>
    <script>
        // Column Modal
        function openColumnModal() {
            document.getElementById('columnModal').classList.remove('hidden');
        }

        function closeColumnModal() {
            document.getElementById('columnModal').classList.add('hidden');
        }

        async function submitField(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('/products/fields', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                if (res.ok) {
                    window.location.reload();
                } else {
                    const err = await res.json();
                    alert(err.error || 'Failed to create field');
                }
            } catch (error) {
                console.error(error);
                alert('An error occurred');
            }
        }

        async function deleteField(id) {
            if (!confirm('Hapus kolom ini? Data di produk yang ada mungkin akan tersembunyi.')) return;
            
            try {
                const res = await fetch(`/products/fields/${id}`, { method: 'DELETE' });
                if (res.ok) window.location.reload();
            } catch (error) {
                console.error(error);
            }
        }

        // Product Modal
        function openProductModal() {
            document.getElementById('productModal').classList.remove('hidden');
            document.getElementById('productForm').reset();
            document.getElementById('productId').value = '';
            document.getElementById('productModalTitle').textContent = 'Tambah Produk';
        }

        function closeProductModal() {
            document.getElementById('productModal').classList.add('hidden');
        }

        function editProduct(id, name, data) {
            openProductModal();
            document.getElementById('productModalTitle').textContent = 'Edit Produk';
            document.getElementById('productId').value = id;
            document.getElementById('productName').value = name;

            // Populate dynamic fields
            // data might be object or need parsing
            const fields = <%- JSON.stringify(fields) %>;
            if (data) {
                fields.forEach(f => {
                    const el = document.getElementById(`field_${f.key}`);
                    if (el && data[f.key]) {
                        el.value = data[f.key];
                    }
                });
            }
        }

        async function submitProduct(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());
            const id = data.id;
            delete data.id; // remove id from payload

            const url = id ? `/products/${id}` : '/products';
            const method = id ? 'PUT' : 'POST';

            try {
                const res = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert('Failed to save product');
                }
            } catch (error) {
                console.error(error);
                alert('An error occurred');
            }
        }

        async function deleteProduct(id) {
            if (!confirm('Hapus produk ini?')) return;
            try {
                const res = await fetch(`/products/${id}`, { method: 'DELETE' });
                if (res.ok) window.location.reload();
            } catch (error) {
                console.error(error);
            }
        }
    </script>
</body>
</html>
