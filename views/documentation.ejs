<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Dokumentasi API' }) %>
</head>
<body>
<%- include('partials/shell-start', { title: 'Dokumentasi', page: 'documentation' }) %>
<%
    const endpoints = [
        { method: 'GET',  path: '/status', desc: 'Cek status koneksi dan QR code', auth: 'Cookie/API Key', params: [] },
        { method: 'POST', path: '/send-message', desc: 'Kirim satu pesan WhatsApp', params: ['<b>to</b> (number)', '<b>message</b> (text)', '<b>reply_to_id</b> (optional)'] },
        { method: 'POST', path: '/send-document', desc: 'Kirim dokumen atau attachment', params: ['<b>to</b> (number)', '<b>url</b> / <b>base64</b> / <b>document</b> (file)', '<b>fileName</b> (optional)', '<b>mimetype</b> (optional)', '<b>caption</b> (optional)'] },
        { method: 'POST', path: '/send-interactive', desc: 'Kirim pesan interaktif dengan tombol atau list', params: ['<b>to</b> (number)', '<b>text</b> (message)', '<b>footer</b> (optional)', '<b>interactiveButtons</b> (array)'] }
    ];
    const features = [
        { icon: 'ri-dashboard-line', title: 'Dashboard', text: 'Real-time connection status, QR code generation, and recent messages.' },
        { icon: 'ri-cursor-line', title: 'Pesan Interaktif', text: 'Kirim pesan dengan tombol (button) dan list untuk meningkatkan interaksi dengan pengguna.' },
        { icon: 'ri-reply-all-line', title: 'Balas Otomatis', text: 'Bot berbasis kata kunci dengan aktif/nonaktif per aturan dan sakelar global.' },
        { icon: 'ri-group-line', title: 'Manajemen User', text: 'Kelola pengguna sistem, buat akun baru, dan atur peran (Admin/User).' },
        { icon: 'ri-key-line', title: 'Kunci API', text: 'Buat/cabut kunci untuk akses terprogram tanpa cookie sesi.' },
        { icon: 'ri-webhook-line', title: 'Integrasi Webhook', text: 'Terima notifikasi real-time termasuk tombol yang ditekan pengguna untuk tracking interaksi.' }
    ];
%>

    <div class="page-head">
        <div>
            <h1 class="page-title">Dokumentasi API</h1>
            <p class="page-sub m-0">Kirim pesan WhatsApp dari sistem Anda lewat REST API.</p>
        </div>
        <a href="/api-keys" class="btn btn-secondary"><i class="ri-key-2-line"></i> Kunci API</a>
    </div>

    <div class="grid gap-4 lg:grid-cols-[1fr_280px]">
        <div class="min-w-0 space-y-4">
            <section class="card" id="auth" aria-labelledby="authTitle">
                <div class="card-head"><h2 class="card-title" id="authTitle"><i class="ri-shield-keyhole-line"></i> Autentikasi</h2></div>
                <div class="card-body grid gap-3 md:grid-cols-2">
                    <div class="rounded-md border border-line p-3">
                        <div class="mb-1 text-sm font-bold text-ink">Kunci API <span class="badge badge-brand ml-1">disarankan</span></div>
                        <p class="m-0 text-sm text-ink-soft">Buat di halaman <a href="/api-keys">Kunci API</a>, kirim lewat header <code class="code">X-API-KEY</code> atau query <code class="code">?api_key=</code>.</p>
                    </div>
                    <div class="rounded-md border border-line p-3">
                        <div class="mb-1 text-sm font-bold text-ink">Cookie sesi</div>
                        <p class="m-0 text-sm text-ink-soft">Masuk lewat dasbor, lalu sertakan cookie <code class="code">auth-token</code> di setiap request.</p>
                    </div>
                </div>
            </section>

            <section class="card" id="endpoints" aria-labelledby="epTitle">
                <div class="card-head"><h2 class="card-title" id="epTitle"><i class="ri-code-s-slash-line"></i> Endpoint</h2></div>
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th class="w-20">Metode</th><th>Endpoint</th><th>Keterangan</th></tr></thead>
                        <tbody>
                        <% endpoints.forEach(ep => { %>
                            <tr>
                                <td class="align-top"><span class="method method-<%= ep.method.toLowerCase() %>"><%= ep.method %></span></td>
                                <td class="align-top"><code class="font-mono text-[13px] text-ink"><%= ep.path %></code></td>
                                <td class="align-top">
                                    <div class="text-ink"><%= ep.desc %></div>
                                    <% if (ep.auth) { %><div class="mt-1 text-xs text-muted">Auth: <%= ep.auth %></div><% } %>
                                    <% if (ep.params.length) { %>
                                    <ul class="m-0 mt-1.5 flex list-none flex-wrap gap-1 p-0">
                                        <% ep.params.forEach(p => { %><li class="rounded-sm bg-surface-2 px-1.5 py-0.5 font-mono text-[12px] text-ink-soft"><%- p %></li><% }) %>
                                    </ul>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="card" id="examples" aria-labelledby="exTitle">
                <div class="card-head"><h2 class="card-title" id="exTitle"><i class="ri-terminal-box-line"></i> Contoh request</h2></div>
            <details class="group border-b border-line last:border-b-0" open>
                <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-ink hover:bg-surface-2">
                    Kirim pesan dengan kunci API<i class="ri-arrow-down-s-line text-muted transition-transform group-open:rotate-180"></i>
                </summary>
                <div class="px-4 pb-4"><pre class="console">$ curl -X POST \
  -H "Content-Type: application/json" \
  -H "X-API-KEY: YOUR_API_KEY" \
  -d '{"to":"6281234567890","message":"Hello via API key!"}' \
  https://gateway.irengcloud.com/send-message</pre></div>
            </details>
            <details class="group border-b border-line last:border-b-0" >
                <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-ink hover:bg-surface-2">
                    Kirim pesan dengan cookie<i class="ri-arrow-down-s-line text-muted transition-transform group-open:rotate-180"></i>
                </summary>
                <div class="px-4 pb-4"><pre class="console">$ curl -X POST \
  -H "Content-Type: application/json" \
  -H "Cookie: auth-token=YOUR_COOKIE_HERE" \
  -d '{"to":"6281234567890","message":"Hello via cookie!"}' \
  https://gateway.irengcloud.com/send-message</pre></div>
            </details>
            <details class="group border-b border-line last:border-b-0" >
                <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-ink hover:bg-surface-2">
                    Kirim dokumen<i class="ri-arrow-down-s-line text-muted transition-transform group-open:rotate-180"></i>
                </summary>
                <div class="px-4 pb-4"><pre class="console">$ curl -X POST \
  -H "X-API-KEY: YOUR_API_KEY" \
  -F "to=6281234567890" \
  -F "caption=Dokumen terlampir" \
  -F "document=@/path/file.pdf" \
  https://gateway.irengcloud.com/send-document</pre></div>
            </details>
            <details class="group border-b border-line last:border-b-0" >
                <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-ink hover:bg-surface-2">
                    Pesan dengan tombol<i class="ri-arrow-down-s-line text-muted transition-transform group-open:rotate-180"></i>
                </summary>
                <div class="px-4 pb-4"><pre class="console">$ curl -X POST \
  -H "Content-Type: application/json" \
  -H "X-API-KEY: YOUR_API_KEY" \
  -d '{
    "to":"6281234567890",
    "text":"Silakan pilih opsi di bawah:",
    "footer":"Pilih salah satu opsi",
    "interactiveButtons":[
      {"name":"quick_reply","buttonParamsJson":"{\"display_text\":\"Ya\",\"id\":\"btn_yes\"}"},
      {"name":"quick_reply","buttonParamsJson":"{\"display_text\":\"Tidak\",\"id\":\"btn_no\"}"},
      {"name":"quick_reply","buttonParamsJson":"{\"display_text\":\"Nanti\",\"id\":\"btn_later\"}"}
    ]
  }' \
  https://gateway.irengcloud.com/send-interactive</pre></div>
            </details>
            <details class="group border-b border-line last:border-b-0" >
                <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-ink hover:bg-surface-2">
                    Pesan dengan list<i class="ri-arrow-down-s-line text-muted transition-transform group-open:rotate-180"></i>
                </summary>
                <div class="px-4 pb-4"><pre class="console">$ curl -X POST \
  -H "Content-Type: application/json" \
  -H "X-API-KEY: YOUR_API_KEY" \
  -d '{
    "to":"6281234567890",
    "text":"Silakan pilih menu layanan:",
    "title":"Layanan Pelanggan",
    "footer":"Pilih dari list di bawah",
    "interactiveButtons":[{
      "name":"single_select",
      "buttonParamsJson":"{\"title\":\"Pilih Menu\",\"sections\":[{\"title\":\"Layanan\",\"rows\":[{\"header\":\"Cek Pesanan\",\"title\":\"Cek Pesanan\",\"description\":\"Lihat status pesanan\",\"id\":\"help_order\"},{\"header\":\"Info Produk\",\"title\":\"Info Produk\",\"description\":\"Tanya tentang produk\",\"id\":\"help_product\"}]}]}"
    }]
  }' \
  https://gateway.irengcloud.com/send-interactive</pre></div>
            </details>
            </section>
        </div>

        <aside class="space-y-4 lg:sticky lg:top-18 lg:self-start">
            <nav class="card p-2 text-sm" aria-label="Isi halaman">
                <a href="#auth" class="block rounded-md px-2 py-1.5 font-semibold text-ink-soft no-underline hover:bg-surface-2">Autentikasi</a>
                <a href="#endpoints" class="block rounded-md px-2 py-1.5 font-semibold text-ink-soft no-underline hover:bg-surface-2">Endpoint</a>
                <a href="#examples" class="block rounded-md px-2 py-1.5 font-semibold text-ink-soft no-underline hover:bg-surface-2">Contoh request</a>
                <a href="#features" class="block rounded-md px-2 py-1.5 font-semibold text-ink-soft no-underline hover:bg-surface-2">Fitur dasbor</a>
            </nav>
            <section class="card" id="features" aria-labelledby="featTitle">
                <div class="card-head"><h2 class="card-title" id="featTitle"><i class="ri-apps-2-line"></i> Fitur dasbor</h2></div>
                <ul class="m-0 list-none divide-y divide-line p-0">
                    <% features.forEach(f => { %>
                    <li class="flex gap-2 px-4 py-2.5">
                        <i class="<%= f.icon %> mt-0.5 text-brand-text"></i>
                        <div><div class="text-sm font-semibold text-ink"><%= f.title %></div><div class="text-xs text-muted"><%= f.text %></div></div>
                    </li>
                    <% }) %>
                </ul>
            </section>
            <p class="m-0 px-1 text-xs text-muted">Detail lebih lengkap ada di <code class="code">README.md</code> dan <code class="code">Documentation.md</code> di repositori.</p>
        </aside>
    </div>

<%- include('partials/shell-end') %>
</body>
</html>
