<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Users' }) %>
</head>
<body>
<%- include('partials/shell-start', { title: 'Users', page: 'users' }) %>
<% const adminCount = users.filter(u => u.role === 'admin').length; %>

    <div class="page-head">
        <div>
            <h1 class="page-title">Users</h1>
            <p class="page-sub m-0"><%= users.length %> pengguna · <%= adminCount %> admin. Admin bisa mengakses pengaturan, semua kunci API, dan mengelola pengguna lain.</p>
        </div>
        <button type="button" class="btn btn-primary" data-dialog-open="addDialog"><i class="ri-user-add-line"></i> Tambah user</button>
    </div>

    <%- include('partials/flash') %>

    <section class="card" aria-label="Daftar pengguna">
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>User</th><th>Email</th><th>Peran</th><th>Bergabung</th><th class="text-right">Aksi</th></tr></thead>
                <tbody>
                <% users.forEach(u => { %>
                    <tr>
                        <td>
                            <div class="flex items-center gap-2">
                                <span class="avatar h-7 w-7 text-xs"><%= u.name.charAt(0).toUpperCase() %></span>
                                <span class="font-semibold text-ink"><%= u.name %></span>
                            </div>
                        </td>
                        <td class="text-ink-soft"><%= u.email %></td>
                        <td><span class="badge <%= u.role === 'admin' ? 'badge-brand' : 'badge-neutral' %>"><%= u.role === 'admin' ? 'Admin' : 'User' %></span></td>
                        <td class="whitespace-nowrap text-muted"><%= new Date(u.createdAt).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                        <td class="whitespace-nowrap text-right">
                            <button type="button" class="btn btn-ghost btn-sm btn-icon" aria-label="Ubah <%= u.name %>"
                                    data-edit-user data-id="<%= u.id %>" data-name="<%= u.name %>" data-email="<%= u.email %>" data-role="<%= u.role %>">
                                <i class="ri-edit-line"></i>
                            </button>
                            <form action="/users/delete/<%= u.id %>" method="POST" data-confirm="Hapus user <%= u.name %>?" class="inline">
                                <button type="submit" class="btn btn-ghost-danger btn-sm btn-icon" aria-label="Hapus <%= u.name %>"><i class="ri-delete-bin-line"></i></button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
        </div>
    </section>

<%- include('partials/shell-end') %>

<!-- Add user -->
<dialog id="addDialog" class="dialog" aria-labelledby="addTitle">
    <form action="/users/add" method="POST">
        <div class="card-head"><h2 class="card-title" id="addTitle"><i class="ri-user-add-line"></i> Tambah user</h2>
            <button type="button" class="btn btn-ghost btn-sm btn-icon" data-dialog-close aria-label="Tutup"><i class="ri-close-line"></i></button></div>
        <div class="card-body space-y-3">
            <div><label class="label" for="addName">Nama</label><input type="text" id="addName" name="name" required class="input" placeholder="Nama lengkap"></div>
            <div><label class="label" for="addEmail">Email</label><input type="email" id="addEmail" name="email" required class="input" placeholder="user@domain.com"></div>
            <div><label class="label" for="addPassword">Kata sandi</label><input type="password" id="addPassword" name="password" required class="input" autocomplete="new-password"></div>
            <div><label class="label" for="addRole">Peran</label>
                <select id="addRole" name="role" class="input"><option value="user">User</option><option value="admin">Admin</option></select></div>
        </div>
        <div class="card-foot">
            <button type="button" class="btn btn-secondary" data-dialog-close>Batal</button>
            <button type="submit" class="btn btn-primary"><i class="ri-save-line"></i> Simpan</button>
        </div>
    </form>
</dialog>

<!-- Edit user -->
<dialog id="editDialog" class="dialog" aria-labelledby="editTitle">
    <form id="editForm" method="POST">
        <div class="card-head"><h2 class="card-title" id="editTitle"><i class="ri-edit-line"></i> Ubah user</h2>
            <button type="button" class="btn btn-ghost btn-sm btn-icon" data-dialog-close aria-label="Tutup"><i class="ri-close-line"></i></button></div>
        <div class="card-body space-y-3">
            <div><label class="label" for="editName">Nama</label><input type="text" name="name" id="editName" required class="input"></div>
            <div><label class="label" for="editEmail">Email</label><input type="email" name="email" id="editEmail" required class="input"></div>
            <div><label class="label" for="editRole">Peran</label>
                <select name="role" id="editRole" class="input"><option value="user">User</option><option value="admin">Admin</option></select></div>
            <div><label class="label" for="editPassword">Kata sandi baru <span class="font-medium text-muted">(opsional)</span></label>
                <input type="password" id="editPassword" name="password" class="input" placeholder="Kosongkan jika tidak diubah" autocomplete="new-password"></div>
        </div>
        <div class="card-foot">
            <button type="button" class="btn btn-secondary" data-dialog-close>Batal</button>
            <button type="submit" class="btn btn-primary"><i class="ri-save-line"></i> Simpan</button>
        </div>
    </form>
</dialog>

<script>
    document.addEventListener('click', (e) => {
        const b = e.target.closest('[data-edit-user]');
        if (!b) return;
        document.getElementById('editForm').action = `/users/update/${encodeURIComponent(b.dataset.id)}`;
        document.getElementById('editName').value = b.dataset.name;
        document.getElementById('editEmail').value = b.dataset.email;
        document.getElementById('editRole').value = b.dataset.role;
        document.getElementById('editDialog').showModal();
    });
</script>
</body>
</html>
