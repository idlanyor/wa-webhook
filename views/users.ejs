<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'User Management' }) %>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">User Management</h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item"><a href="/dashboard">Dasbor</a></li>
                            <li class="breadcrumb-item active">Users</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">

                <!-- Alerts -->
                <% if (locals.error) { %>
                <div class="alert alert-danger alert-dismissible fade show fade-in" role="alert">
                    <i class="ri-error-warning-line mr-2"></i> <%= error %>
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
                <% } %>
                <% if (locals.success) { %>
                <div class="alert alert-success alert-dismissible fade show fade-in" role="alert">
                    <i class="ri-checkbox-circle-line mr-2"></i> <%= success %>
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
                <% } %>

                <div class="row">
                    <!-- Add User Form -->
                    <div class="col-lg-4">
                        <div class="card card-outline card-primary fade-in">
                            <div class="card-header">
                                <h3 class="card-title"><i class="ri-user-add-line text-primary mr-2"></i>Add New User</h3>
                            </div>
                            <div class="card-body">
                                <form action="/users/add" method="POST">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Name</label>
                                        <input type="text" name="name" required class="form-control" placeholder="User Full Name">
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">Email</label>
                                        <input type="email" name="email" required class="form-control" placeholder="user@example.com">
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">Password</label>
                                        <input type="password" name="password" required class="form-control" placeholder="••••••••">
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">Role</label>
                                        <select name="role" class="form-control">
                                            <option value="user">User</option>
                                            <option value="admin">Admin</option>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-block">
                                        <i class="ri-save-line mr-1"></i> Create User
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Stats -->
                        <div class="row">
                            <div class="col-6">
                                <div class="info-box">
                                    <span class="info-box-icon bg-info elevation-1"><i class="ri-group-line"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Total</span>
                                        <span class="info-box-number"><%= users.length %></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-box">
                                    <span class="info-box-icon bg-purple elevation-1" style="background:linear-gradient(135deg,#7c3aed,#4f46e5)!important;">
                                        <i class="ri-shield-user-line"></i>
                                    </span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Admins</span>
                                        <span class="info-box-number"><%= users.filter(u => u.role === 'admin').length %></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="callout callout-warning fade-in">
                            <h6 class="font-weight-bold"><i class="ri-information-line mr-1"></i>Info</h6>
                            <p class="mb-0" style="font-size:0.82rem;">Admin users have full access to all settings, API keys, and can manage other users.</p>
                        </div>
                    </div>

                    <!-- Users Table -->
                    <div class="col-lg-8">
                        <div class="card card-outline card-success fade-in">
                            <div class="card-header">
                                <h3 class="card-title"><i class="ri-group-line text-success mr-2"></i>All Users</h3>
                                <div class="card-tools">
                                    <small class="text-muted">Sorted by newest</small>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover table-striped mb-0">
                                        <thead>
                                            <tr>
                                                <th>User</th>
                                                <th>Email</th>
                                                <th>Role</th>
                                                <th>Joined</th>
                                                <th class="text-right">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% users.forEach(u => { %>
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="d-flex align-items-center justify-content-center rounded-lg mr-2 text-white font-weight-bold"
                                                             style="width:32px;height:32px;background:linear-gradient(135deg,#4f46e5,#7c3aed);font-size:0.85rem;flex-shrink:0;border-radius:8px!important;">
                                                            <%= u.name.charAt(0).toUpperCase() %>
                                                        </div>
                                                        <span class="font-weight-bold"><%= u.name %></span>
                                                    </div>
                                                </td>
                                                <td class="text-muted"><%= u.email %></td>
                                                <td>
                                                    <span class="badge <%= u.role === 'admin' ? 'badge-warning' : 'badge-primary' %>">
                                                        <%= u.role %>
                                                    </span>
                                                </td>
                                                <td class="text-muted" style="font-size:0.8rem;">
                                                    <%= new Date(u.createdAt).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                                </td>
                                                <td class="text-right">
                                                    <button onclick="editUser('<%= u._id %>', '<%= u.name %>', '<%= u.email %>', '<%= u.role %>')"
                                                            class="btn btn-sm btn-info mr-1">
                                                        <i class="ri-edit-line"></i>
                                                    </button>
                                                    <form action="/users/delete/<%= u._id %>" method="POST"
                                                          data-confirm="Are you sure you want to delete this user?"
                                                          style="display:inline;">
                                                        <button type="submit" class="btn btn-sm btn-danger">
                                                            <i class="ri-delete-bin-line"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>WhatsApp Webhook</strong> &copy; 2024.
        <div class="float-right d-none d-sm-inline-block"><b>Version</b> 1.0.0</div>
    </footer>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold">
                    <i class="ri-edit-line mr-2"></i> Edit User
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <form id="editForm" method="POST">
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold">Name</label>
                        <input type="text" name="name" id="editName" required class="form-control">
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Email</label>
                        <input type="email" name="email" id="editEmail" required class="form-control">
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Role</label>
                        <select name="role" id="editRole" class="form-control">
                            <option value="user">User</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">New Password <small class="text-muted">(optional)</small></label>
                        <input type="password" name="password" class="form-control" placeholder="Leave blank to keep current">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ri-save-line mr-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('partials/bottom-nav') %>

<script>
    function editUser(id, name, email, role) {
        document.getElementById('editForm').action = `/users/update/${id}`;
        document.getElementById('editName').value = name;
        document.getElementById('editEmail').value = email;
        document.getElementById('editRole').value = role;
        $('#editModal').modal('show');
    }
</script>
<%- include('partials/simple-scripts') %>
</body>
</html>
