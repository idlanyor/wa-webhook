<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Error ' + (locals.status || '500') }) %>
</head>
<body>
<div class="fixed top-3 right-3"><%- include('partials/theme-switch') %></div>
<main class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-md">
        <img src="/img/irengcloud.svg" alt="IrengCloud" class="logo-light mb-8 h-6 w-auto">
        <img src="/img/irengcloud-light.svg" alt="IrengCloud" class="logo-dark mb-8 h-6 w-auto">
        <p class="m-0 font-mono text-sm font-bold text-danger">Error <%= locals.status || '500' %></p>
        <h1 class="mt-1 mb-2 text-2xl font-bold text-ink"><%= locals.message || 'Terjadi kesalahan. Coba lagi nanti.' %></h1>
        <p class="mb-6 text-sm text-muted">Jika masalah berlanjut, periksa log server.</p>

        <% if (locals.error && locals.error.stack && process.env.NODE_ENV === 'development') { %>
        <pre class="console mb-6 max-h-48 overflow-y-auto"><%= error.stack %></pre>
        <% } %>

        <div class="flex gap-2">
            <a href="/" class="btn btn-primary"><i class="ri-home-4-line"></i> Ke dasbor</a>
            <button type="button" class="btn btn-secondary" onclick="history.back()">Kembali</button>
        </div>
    </div>
</main>
</body>
</html>
