<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Daftar' }) %>
</head>
<body>
<%- include('partials/auth-start') %>
            <h1 class="m-0 text-2xl font-bold text-ink">Buat akun</h1>
            <p class="mt-1 mb-6 text-sm text-muted">Mulai kelola gateway WhatsApp Anda.</p>

            <%- include('partials/flash') %>

            <form action="/register" method="POST" class="space-y-4">
                <div>
                    <label class="label" for="name">Nama lengkap</label>
                    <input type="text" id="name" name="name" class="input" autocomplete="name" required>
                </div>
                <div>
                    <label class="label" for="email">Email</label>
                    <input type="email" id="email" name="email" class="input" placeholder="nama@email.com" autocomplete="email" required>
                </div>
                <div>
                    <label class="label" for="password">Kata sandi</label>
                    <div class="input-wrap">
                        <input type="password" name="password" id="password" class="input" autocomplete="new-password" required>
                        <button type="button" class="btn btn-ghost btn-sm btn-icon h-7 w-7" onclick="togglePassword('password', this)" aria-label="Tampilkan kata sandi"><i class="ri-eye-line"></i></button>
                    </div>
                </div>
                <div>
                    <label class="label" for="confirmPassword">Ulangi kata sandi</label>
                    <div class="input-wrap">
                        <input type="password" name="confirmPassword" id="confirmPassword" class="input" autocomplete="new-password" required>
                        <button type="button" class="btn btn-ghost btn-sm btn-icon h-7 w-7" onclick="togglePassword('confirmPassword', this)" aria-label="Tampilkan kata sandi"><i class="ri-eye-line"></i></button>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Daftar</button>
            </form>

            <p class="mt-6 text-center text-sm text-muted">Sudah punya akun? <a href="/login" class="font-semibold">Masuk</a></p>
<%- include('partials/auth-end') %>
<script>
    const password = document.getElementById('password');
    const confirmPassword = document.getElementById('confirmPassword');
    function validatePassword() {
        confirmPassword.setCustomValidity(password.value !== confirmPassword.value ? 'Kata sandi tidak cocok' : '');
    }
    password.addEventListener('change', validatePassword);
    confirmPassword.addEventListener('input', validatePassword);
</script>
</body>
</html>
