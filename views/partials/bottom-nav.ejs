<%
    const bottomMenuItems = [
        { 
            id: 'dashboard', 
            label: 'Dasbor', 
            path: '/dashboard', 
            icon: 'ri-dashboard-line'
        },
        { 
            id: 'auto-reply', 
            label: 'Auto Reply', 
            path: '/auto-reply', 
            icon: 'ri-reply-all-line'
        },
        { 
            id: 'scheduled-messages', 
            label: 'Jadwal', 
            path: '/scheduled-messages', 
            icon: 'ri-calendar-schedule-line'
        },
        { 
            id: 'api-keys', 
            label: 'API Keys', 
            path: '/api-keys', 
            icon: 'ri-key-line'
        },
        { 
            id: 'users', 
            label: 'Users', 
            path: '/users', 
            icon: 'ri-group-line',
            adminOnly: true
        },
        { 
            id: 'documentation', 
            label: 'Docs', 
            path: '/documentation', 
            icon: 'ri-file-text-line',
            hideForAdmin: true
        }
    ];

    const filteredBottomItems = bottomMenuItems.filter(item => {
        if (item.adminOnly && (!locals.user || locals.user.role !== 'admin')) return false;
        if (item.hideForAdmin && (locals.user && locals.user.role === 'admin')) return false;
        return true;
    });
%>

<!-- Mobile Bottom Navigation (hidden on desktop) -->
<nav class="d-lg-none fixed-bottom bg-white border-top shadow-sm" 
     style="z-index:1030;padding-bottom:env(safe-area-inset-bottom);">
    <div class="d-flex justify-content-around align-items-center" style="height:56px;">
        <% filteredBottomItems.forEach(item => { %>
        <% const isActive = typeof page !== 'undefined' && page === item.id; %>
        <a href="<%= item.path %>" 
           class="d-flex flex-column align-items-center justify-content-center flex-grow-1 text-decoration-none py-2"
           style="color: <%= isActive ? '#25D366' : '#6c757d' %>; min-width:0;">
            <i class="<%= item.icon %>" style="font-size:1.3rem;"></i>
            <span style="font-size:0.62rem;font-weight:<%= isActive ? '700' : '500' %>;margin-top:2px;white-space:nowrap;">
                <%= item.label %>
            </span>
        </a>
        <% }); %>
    </div>
</nav>

<style>
@media (max-width: 991px) {
    .content-wrapper {
        padding-bottom: calc(56px + env(safe-area-inset-bottom)) !important;
    }
}
</style>
