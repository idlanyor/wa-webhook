<!-- Status Info Boxes -->
<div class="row">

    <!-- 1. Connection Status -->
    <div class="col-6 col-lg-3">
        <div class="info-box fade-in">
            <span class="info-box-icon bg-primary elevation-1">
                <i id="statusIcon" class="ri-signal-wifi-line"></i>
            </span>
            <div class="info-box-content">
                <span class="info-box-text text-uppercase" style="font-size:0.7rem;font-weight:700;letter-spacing:.05em;">Koneksi</span>
                <span class="info-box-number" id="connectionStatus" style="font-size:1rem;">Menghubungkan…</span>
                <div class="d-flex align-items-center mt-1">
                    <span id="statusIndicator" class="status-dot disconnected"></span>
                    <small id="socketStatus" class="text-muted" style="font-size:0.68rem;font-family:monospace;">Socket: ...</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Live Messages -->
    <div class="col-6 col-lg-3">
        <div class="info-box fade-in">
            <span class="info-box-icon bg-success elevation-1">
                <i class="ri-chat-check-line"></i>
            </span>
            <div class="info-box-content">
                <span class="info-box-text text-uppercase" style="font-size:0.7rem;font-weight:700;letter-spacing:.05em;">Pesan Live</span>
                <span class="info-box-number" id="messageCount">--</span>
                <small class="text-muted">Sesi monitoring aktif</small>
            </div>
        </div>
    </div>

    <!-- 3. Uptime -->
    <div class="col-6 col-lg-3">
        <div class="info-box fade-in">
            <span class="info-box-icon bg-purple elevation-1" style="background:linear-gradient(135deg,#7c3aed,#4f46e5)!important;">
                <i class="ri-time-line"></i>
            </span>
            <div class="info-box-content">
                <span class="info-box-text text-uppercase" style="font-size:0.7rem;font-weight:700;letter-spacing:.05em;">Uptime Sesi</span>
                <span class="info-box-number" id="uptime">--</span>
                <small class="text-muted">Berjalan aktif</small>
            </div>
        </div>
    </div>

    <!-- 4. Active Session -->
    <div class="col-6 col-lg-3">
        <div class="info-box fade-in">
            <span class="info-box-icon bg-warning elevation-1">
                <i class="ri-whatsapp-line"></i>
            </span>
            <div class="info-box-content">
                <span class="info-box-text text-uppercase" style="font-size:0.7rem;font-weight:700;letter-spacing:.05em;">Sesi Terhubung</span>
                <span class="info-box-number" id="activePhone" style="font-size:0.9rem;">Menunggu Sesi</span>
                <small class="text-muted" id="activeProfileName">Belum terhubung</small>
            </div>
        </div>
    </div>

</div>