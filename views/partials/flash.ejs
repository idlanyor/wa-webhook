<% if (locals.error) { %>
<div class="alert alert-danger mb-4" role="alert" data-autoclose>
    <i class="ri-error-warning-line mt-0.5"></i><span><%= error %></span>
    <button type="button" class="alert-close" data-dismiss="alert" aria-label="Tutup"><i class="ri-close-line"></i></button>
</div>
<% } %>
<% if (locals.success) { %>
<div class="alert alert-success mb-4" role="status" data-autoclose>
    <i class="ri-checkbox-circle-line mt-0.5"></i><span><%= success %></span>
    <button type="button" class="alert-close" data-dismiss="alert" aria-label="Tutup"><i class="ri-close-line"></i></button>
</div>
<% } %>
