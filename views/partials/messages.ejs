<!-- Live Messages Card -->
<div class="card card-outline card-info" id="messagesCard">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ri-message-2-line text-info mr-2"></i>
            Aktivitas Pesan
            <span class="badge badge-info ml-2" style="font-size:0.65rem;border-radius:20px;">
                <i class="ri-record-circle-line"></i> LIVE
            </span>
        </h3>
        <div class="card-tools">
            <small class="text-muted">Log real-time</small>
        </div>
    </div>
    <div class="card-body p-3">
        <div id="messagesList">
            <!-- Placeholder -->
            <div id="messagesPlaceholder" class="text-center py-4">
                <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3 bg-light"
                     style="width:48px;height:48px;">
                    <i class="ri-mail-open-line text-muted" style="font-size:1.4rem;"></i>
                </div>
                <h6 class="text-muted text-uppercase font-weight-bold" style="font-size:0.72rem;letter-spacing:.05em;">Belum Ada Aktivitas</h6>
                <p class="text-muted mb-0" style="font-size:0.8rem;">Hubungkan WhatsApp dan mulai kirim/terima pesan untuk melihat aktivitas log secara real-time di sini.</p>
            </div>
        </div>
    </div>
</div>