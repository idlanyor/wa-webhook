<!-- Quick Actions Card -->
<div class="card card-outline card-purple" style="border-color:#7c3aed;">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ri-flashlight-line mr-2" style="color:#7c3aed;"></i>
            Aksi Cepat
        </h3>
        <div class="card-tools">
            <small class="text-muted">Kendalikan sesi WhatsApp Anda</small>
        </div>
    </div>
    <div class="card-body p-3">
        <button class="btn btn-warning btn-block mb-2" id="resetSessionBtn">
            <i class="ri-refresh-line mr-1"></i> Reset Sesi
        </button>
        <button class="btn btn-primary btn-block mb-2" id="refreshBtn" onclick="refreshStatus()">
            <i class="ri-refresh-line mr-1"></i>
            <span id="refreshText">Segarkan Status</span>
        </button>
        <button class="btn btn-success btn-block mb-2" id="testBtn" onclick="testMessage()" disabled>
            <i class="ri-send-plane-line mr-1"></i> Kirim Pesan Uji
        </button>
        <button class="btn btn-danger btn-block" id="waLogoutBtn" onclick="waLogout()" disabled>
            <i class="ri-logout-circle-r-line mr-1"></i> Keluar WhatsApp
        </button>

        <!-- Action Status -->
        <div id="actionStatus" class="alert mt-3 mb-0 py-2 d-none" role="alert">
            <div class="d-flex align-items-center">
                <i class="ri-loader-4-line spin mr-2"></i>
                <span id="actionStatusText" style="font-size:0.83rem;">Memproses…</span>
            </div>
        </div>
    </div>
</div>