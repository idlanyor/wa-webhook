<%
    const menuItems = [
        { 
            id: 'dashboard', 
            label: 'Dasbor', 
            path: '/dashboard', 
            icon: 'ri-dashboard-line'
        },
        { 
            id: 'auto-reply', 
            label: 'Balas Otomatis', 
            path: '/auto-reply', 
            icon: 'ri-reply-all-line'
        },
        { 
            id: 'scheduled-messages', 
            label: 'Pesan Terjadwal', 
            path: '/scheduled-messages', 
            icon: 'ri-calendar-schedule-line'
        },
        { 
            id: 'api-keys', 
            label: 'Kunci API', 
            path: '/api-keys', 
            icon: 'ri-key-line'
        },
        { 
            id: 'users', 
            label: 'Users', 
            path: '/users', 
            icon: 'ri-group-line',
            adminOnly: true
        },
        { 
            id: 'settings', 
            label: 'Pengaturan', 
            path: '/settings', 
            icon: 'ri-settings-3-line',
            adminOnly: true
        },
        { 
            id: 'documentation', 
            label: 'Dokumentasi', 
            path: '/documentation', 
            icon: 'ri-file-text-line'
        }
    ];

    const filteredMenuItems = menuItems.filter(item => {
        if (item.adminOnly && (!locals.user || locals.user.role !== 'admin')) return false;
        return true;
    });
%>

<!-- Main Sidebar Container -->
<aside class="main-sidebar sidebar-dark-success elevation-4">
    <!-- Brand Logo -->
    <a href="/dashboard" class="brand-link">
        <div class="d-inline-flex align-items-center justify-content-center rounded-lg me-2" 
             style="width:36px;height:36px;background:rgba(255,255,255,0.2);flex-shrink:0;">
            <i class="ri-whatsapp-line text-white" style="font-size:1.2rem;"></i>
        </div>
        <span class="brand-text font-weight-bold">WA Webhook</span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Sidebar user panel -->
        <% if (typeof user !== 'undefined' && user) { %>
        <div class="user-panel mt-3 pb-3 mb-3 d-flex">
            <div class="image">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-success text-white" 
                     style="width:34px;height:34px;font-weight:700;font-size:0.9rem;">
                    <%= (user.name || 'U').substring(0, 1).toUpperCase() %>
                </div>
            </div>
            <div class="info">
                <a href="#" class="d-block font-weight-bold"><%= user.name || 'User' %></a>
                <span class="text-muted" style="font-size:0.75rem;"><%= user.email %></span>
            </div>
        </div>
        <% } %>

        <!-- Sidebar Menu -->
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                <% filteredMenuItems.forEach(item => { %>
                <% const isActive = typeof page !== 'undefined' && page === item.id; %>
                <li class="nav-item">
                    <a href="<%= item.path %>" class="nav-link <%= isActive ? 'active' : '' %>">
                        <i class="nav-icon <%= item.icon %>"></i>
                        <p><%= item.label %></p>
                    </a>
                </li>
                <% }); %>
            </ul>
        </nav>
    </div>

    <!-- Footer -->
    <div class="sidebar-footer p-3 border-top" style="border-color:rgba(255,255,255,0.1)!important;">
        <p class="text-center text-muted mb-0" style="font-size:0.7rem;">Version 1.0.0 • WhatsApp Webhook</p>
    </div>
</aside>
