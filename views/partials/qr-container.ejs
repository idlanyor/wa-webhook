<section class="card mb-4" id="connectionCard" style="display:none;" aria-labelledby="connectTitle">
    <div class="card-head">
        <h2 class="card-title" id="connectTitle"><i class="ri-smartphone-line"></i> Hubungkan WhatsApp</h2>
        <span class="text-xs text-muted" id="connectionDescription">Pilih metode koneksi.</span>
    </div>
    <div class="card-body" id="disconnectedState">
        <div class="tabs mb-4" role="tablist">
            <button type="button" class="tab" role="tab" id="qrTab" data-tab="qrMethod" aria-selected="true"><i class="ri-qr-code-line"></i> Kode QR</button>
            <button type="button" class="tab" role="tab" id="pairingTab" data-tab="pairingMethod" aria-selected="false"><i class="ri-keyboard-box-line"></i> Kode pairing</button>
        </div>

        <div id="qrMethod" role="tabpanel" class="grid items-start gap-6 md:grid-cols-[auto_1fr]">
            <div class="inline-block rounded-md border border-line bg-white p-3"><div id="qrcode"></div></div>
            <div>
                <div class="eyebrow mb-2">Cara memindai</div>
                <ol class="m-0 list-decimal space-y-1 pl-5 text-sm text-ink-soft">
                    <li>Buka <strong>WhatsApp</strong> di ponsel.</li>
                    <li>Ketuk <strong>Menu (⋮)</strong> di Android atau <strong>Pengaturan</strong> di iPhone.</li>
                    <li>Pilih <strong>Perangkat Tertaut</strong> → <strong>Tautkan Perangkat</strong>.</li>
                    <li>Arahkan kamera ke kode QR.</li>
                </ol>
            </div>
        </div>

        <div id="pairingMethod" role="tabpanel" hidden class="max-w-md">
            <label class="label" for="phoneNumber">Nomor WhatsApp</label>
            <div class="flex gap-2">
                <input type="text" id="phoneNumber" class="input font-mono" placeholder="6281234567890" inputmode="numeric">
                <button type="button" onclick="requestPairingCode()" class="btn btn-primary" id="pairingBtn">
                    <i class="ri-key-2-line"></i> Minta kode
                </button>
            </div>
            <p class="hint">Nomor lengkap dengan kode negara, tanpa “+”.</p>

            <div id="pairingCodeResult" class="mt-4 rounded-md border border-line bg-surface-2 p-4" style="display:none;">
                <div class="eyebrow">Kode pairing</div>
                <div id="pairingCodeDisplay" class="my-1 font-mono text-2xl font-bold tracking-[0.3em] text-brand-text">--</div>
                <p class="m-0 text-sm text-ink-soft">Buka notifikasi <strong>Pairing Device</strong> di ponsel, lalu masukkan kode 8 digit di atas.</p>
            </div>
        </div>
    </div>
</section>

<script>
    async function requestPairingCode() {
        const phone = document.getElementById('phoneNumber').value;
        if (!phone) return showNotification('Masukkan nomor telepon', 'warning');

        let fullPhone = phone.replace(/[^\d+]/g, '');
        if (fullPhone.startsWith('+')) fullPhone = fullPhone.substring(1);
        else if (fullPhone.startsWith('0')) fullPhone = '62' + fullPhone.substring(1);

        // Each request issues a NEW code that invalidates the previous one.
        const btn = document.getElementById('pairingBtn');
        btn.disabled = true;
        const originalLabel = btn.innerHTML;
        btn.innerHTML = '<i class="ri-loader-4-line spin"></i> Meminta…';

        try {
            const response = await fetch('/pairing-code', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phoneNumber: fullPhone })
            });
            const data = await response.json();
            if (data.success) {
                document.getElementById('pairingCodeResult').style.display = 'block';
                document.getElementById('pairingCodeDisplay').textContent = data.pairingCode.match(/.{1,4}/g).join('-');
                btn.innerHTML = '<i class="ri-time-line"></i> Aktif 60 detik';
                setTimeout(() => { btn.disabled = false; btn.innerHTML = originalLabel; }, 60000);
                return;
            }
            showNotification('Gagal: ' + data.message, 'error');
        } catch (error) {
            showNotification('Terjadi kesalahan', 'error');
        }
        btn.disabled = false;
        btn.innerHTML = originalLabel;
    }
</script>
