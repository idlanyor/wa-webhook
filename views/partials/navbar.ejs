<!-- Navbar -->
<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                <i class="ri-menu-line"></i>
            </a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <div class="nav-link">
                <span class="font-weight-bold text-dark" style="font-size:1rem;">
                    <%= typeof title !== 'undefined' ? title : 'Dasbor' %>
                </span>
                <small class="d-block text-muted" style="font-size:0.72rem;line-height:1.2;">
                    Kelola layanan WhatsApp Webhook Anda
                </small>
            </div>
        </li>
    </ul>

    <!-- Right navbar links -->
    <ul class="navbar-nav ml-auto">
        <!-- User Info -->
        <% if (typeof user !== 'undefined' && user) { %>
        <li class="nav-item d-none d-sm-flex align-items-center pr-3 mr-2 border-right">
            <div class="text-right">
                <p class="mb-0 font-weight-bold text-dark" style="font-size:0.85rem;line-height:1.2;"><%= user.name || 'User' %></p>
                <small class="text-muted" style="font-size:0.72rem;"><%= user.email %></small>
            </div>
            <div class="ml-2 d-flex align-items-center justify-content-center rounded-lg text-white font-weight-bold"
                 style="width:36px;height:36px;background:linear-gradient(135deg,#4f46e5,#7c3aed);font-size:0.9rem;border-radius:10px!important;">
                <%= (user.name || 'U').substring(0, 1).toUpperCase() %>
            </div>
        </li>
        <% } %>

        <!-- Logout -->
        <li class="nav-item">
            <form id="logoutForm" action="/logout-user" method="POST" data-confirm="Apakah Anda yakin ingin logout?">
                <button type="submit" class="btn btn-sm btn-danger ml-2 mr-2" style="border-radius:8px;">
                    <i class="ri-logout-box-line"></i>
                    <span class="d-none d-sm-inline ml-1">Keluar</span>
                </button>
            </form>
        </li>
    </ul>
</nav>
