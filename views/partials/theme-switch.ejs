<div class="theme-switch" role="group" aria-label="Tema">
    <button type="button" data-theme-set="light" aria-pressed="false" title="Terang"><i class="ri-sun-line"></i><span class="hidden xl:inline">Terang</span></button>
    <button type="button" data-theme-set="dark" aria-pressed="false" title="Gelap"><i class="ri-moon-line"></i><span class="hidden xl:inline">Gelap</span></button>
    <button type="button" data-theme-set="system" aria-pressed="false" title="Ikuti sistem"><i class="ri-computer-line"></i><span class="hidden xl:inline">Sistem</span></button>
</div>
