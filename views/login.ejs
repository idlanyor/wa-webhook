<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Masuk', description: 'Masuk ke dasbor WA Webhook IrengCloud untuk mengelola sesi WhatsApp, kunci API, webhook, dan balas otomatis.' }) %>
</head>
<body>
<%- include('partials/auth-start') %>
            <h1 class="m-0 text-2xl font-bold text-ink">Masuk</h1>
            <p class="mt-1 mb-6 text-sm text-muted">Kelola gateway WhatsApp Anda.</p>

            <%- include('partials/flash') %>

            <form action="/login" method="POST" class="space-y-4">
                <div>
                    <label class="label" for="email">Email</label>
                    <input type="email" id="email" name="email" class="input" placeholder="nama@email.com" autocomplete="email" required autofocus>
                </div>
                <div>
                    <label class="label" for="passwordInput">Kata sandi</label>
                    <div class="input-wrap">
                        <input type="password" name="password" id="passwordInput" class="input" autocomplete="current-password" required>
                        <button type="button" class="btn btn-ghost btn-sm btn-icon h-7 w-7" onclick="togglePassword('passwordInput', this)" aria-label="Tampilkan kata sandi"><i class="ri-eye-line"></i></button>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Masuk</button>
            </form>

            <p class="mt-6 text-center text-sm text-muted">Belum punya akun? <a href="/register" class="font-semibold">Daftar</a></p>
<%- include('partials/auth-end') %>
</body>
</html>
