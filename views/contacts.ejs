<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Manajemen Kontak' }) %>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">Manajemen Kontak</h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item"><a href="/dashboard">Dasbor</a></li>
                            <li class="breadcrumb-item active">Kontak</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">

                <!-- Alerts -->
                <% if (locals.error) { %>
                <div class="alert alert-danger alert-dismissible fade show fade-in" role="alert">
                    <i class="ri-error-warning-line mr-2"></i> <%= error %>
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
                <% } %>
                <% if (locals.success) { %>
                <div class="alert alert-success alert-dismissible fade show fade-in" role="alert">
                    <i class="ri-checkbox-circle-line mr-2"></i> <%= success %>
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
                <% } %>

                <!-- Action Cards -->
                <div class="row">
                    <!-- Add Contact -->
                    <div class="col-md-4">
                        <div class="card card-outline card-primary fade-in">
                            <div class="card-header">
                                <h3 class="card-title"><i class="ri-user-add-line text-primary mr-2"></i>Tambah Kontak Baru</h3>
                            </div>
                            <div class="card-body">
                                <form action="/contacts/add" method="POST">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Nama</label>
                                        <input type="text" id="name" name="name" required class="form-control" placeholder="Masukkan nama">
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">Nomor Telepon</label>
                                        <input type="text" id="phone" name="phone" required class="form-control" placeholder="6281234567890">
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">Tag <small class="text-muted">(pisahkan dengan koma)</small></label>
                                        <input type="text" id="tags" name="tags" class="form-control" placeholder="vip, pelanggan">
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-block">
                                        <i class="ri-save-line mr-1"></i> Simpan Kontak
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Import VCF -->
                    <div class="col-md-4">
                        <div class="card card-outline card-success fade-in">
                            <div class="card-header">
                                <h3 class="card-title"><i class="ri-upload-2-line text-success mr-2"></i>Impor dari VCF</h3>
                            </div>
                            <div class="card-body">
                                <form action="/contacts/import" method="POST" enctype="multipart/form-data">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Berkas VCF</label>
                                        <div class="custom-file">
                                            <input type="file" class="custom-file-input" id="vcfFile" name="vcfFile" accept=".vcf" required>
                                            <label class="custom-file-label" for="vcfFile">Pilih file .vcf</label>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-success btn-block">
                                        <i class="ri-upload-2-line mr-1"></i> Impor VCF
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Import CSV -->
                    <div class="col-md-4">
                        <div class="card card-outline card-warning fade-in">
                            <div class="card-header">
                                <h3 class="card-title"><i class="ri-file-excel-2-line text-warning mr-2"></i>Impor dari CSV</h3>
                                <div class="card-tools">
                                    <small class="text-muted">Kolom: Nama, Nomor</small>
                                </div>
                            </div>
                            <div class="card-body">
                                <form action="/contacts/import/csv" method="POST" enctype="multipart/form-data">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Berkas CSV</label>
                                        <div class="custom-file">
                                            <input type="file" class="custom-file-input" id="csvFile" name="csvFile" accept=".csv" required>
                                            <label class="custom-file-label" for="csvFile">Pilih file .csv</label>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-warning btn-block text-white">
                                        <i class="ri-upload-2-line mr-1"></i> Impor CSV
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact List -->
                <div class="card card-outline card-info fade-in">
                    <div class="card-header">
                        <h3 class="card-title"><i class="ri-contacts-book-2-line text-info mr-2"></i>Daftar Kontak</h3>
                        <div class="card-tools">
                            <small class="text-muted">Semua kontak yang tersimpan</small>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Nama</th>
                                        <th>Nomor Telepon</th>
                                        <th>Tag</th>
                                        <th class="text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (contacts.length > 0) { %>
                                        <% contacts.forEach(contact => { %>
                                        <tr>
                                            <td class="font-weight-bold"><%= contact.name %></td>
                                            <td><%= contact.phone %></td>
                                            <td>
                                                <% if (contact.tags) { %>
                                                <% contact.tags.split(',').forEach(tag => { %>
                                                <span class="badge badge-secondary mr-1"><%= tag.trim() %></span>
                                                <% }) %>
                                                <% } else { %>
                                                <span class="text-muted">-</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center justify-content-center flex-wrap" style="gap:6px;">
                                                    <form action="/contacts/delete/<%= contact.id %>" method="POST"
                                                          data-confirm="Apakah Anda yakin ingin menghapus kontak ini?" style="display:inline;">
                                                        <button type="submit" class="btn btn-sm btn-danger">
                                                            <i class="ri-delete-bin-line"></i>
                                                        </button>
                                                    </form>
                                                    <form action="/contacts/tags/<%= contact.id %>" method="POST" style="display:inline-flex;align-items:center;gap:4px;">
                                                        <input type="text" name="tags" value="<%= contact.tags || '' %>"
                                                               class="form-control form-control-sm" placeholder="tag" style="width:90px;">
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                            <i class="ri-save-line"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-5">
                                            <i class="ri-contacts-book-line d-block" style="font-size:2.5rem;margin-bottom:8px;"></i>
                                            Belum ada kontak. Tambahkan kontak untuk memulai!
                                        </td>
                                    </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Pagination -->
                    <% if (totalPages > 1) { %>
                    <div class="card-footer clearfix">
                        <ul class="pagination pagination-sm m-0 float-right">
                            <% if (currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link" href="/contacts?page=<%= currentPage - 1 %>">
                                    <i class="ri-arrow-left-s-line"></i>
                                </a>
                            </li>
                            <% } %>
                            <% for (let p = 1; p <= totalPages; p++) { %>
                            <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                                <a class="page-link" href="/contacts?page=<%= p %>"><%= p %></a>
                            </li>
                            <% } %>
                            <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link" href="/contacts?page=<%= currentPage + 1 %>">
                                    <i class="ri-arrow-right-s-line"></i>
                                </a>
                            </li>
                            <% } %>
                        </ul>
                    </div>
                    <% } %>
                </div>

            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>WhatsApp Webhook</strong> &copy; 2024.
        <div class="float-right d-none d-sm-inline-block"><b>Version</b> 1.0.0</div>
    </footer>
</div>

<%- include('partials/bottom-nav') %>
<%- include('partials/simple-scripts') %>
</body>
</html>
