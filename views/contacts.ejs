<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Kontak' }) %>
</head>
<body>
<%- include('partials/shell-start', { title: 'Kontak', page: 'contacts' }) %>

    <div class="page-head">
        <div>
            <h1 class="page-title">Kontak</h1>
            <p class="page-sub m-0">Simpan dan beri tag nomor tujuan.</p>
        </div>
    </div>

    <%- include('partials/flash') %>

    <div class="grid gap-4 lg:grid-cols-3">
        <aside class="space-y-4">
            <form action="/contacts/add" method="POST" class="card">
                <div class="card-head"><h2 class="card-title"><i class="ri-user-add-line"></i> Kontak baru</h2></div>
                <div class="card-body space-y-3">
                    <div><label class="label" for="name">Nama</label><input type="text" id="name" name="name" required class="input" placeholder="Nama"></div>
                    <div><label class="label" for="phone">Nomor</label><input type="text" id="phone" name="phone" required class="input font-mono" placeholder="6281234567890"></div>
                    <div><label class="label" for="tags">Tag</label><input type="text" id="tags" name="tags" class="input" placeholder="vip, pelanggan"><p class="hint">Pisahkan dengan koma.</p></div>
                </div>
                <div class="card-foot"><button type="submit" class="btn btn-primary"><i class="ri-save-line"></i> Simpan</button></div>
            </form>

            <section class="card">
                <div class="card-head"><h2 class="card-title"><i class="ri-upload-2-line"></i> Impor</h2></div>
                <div class="card-body space-y-4">
                    <form action="/contacts/import" method="POST" enctype="multipart/form-data" class="space-y-2">
                        <label class="label" for="vcfFile">Berkas VCF</label>
                        <input type="file" class="input" id="vcfFile" name="vcfFile" accept=".vcf" required>
                        <button type="submit" class="btn btn-secondary btn-block"><i class="ri-upload-2-line"></i> Impor VCF</button>
                    </form>
                    <div class="divider"></div>
                    <form action="/contacts/import/csv" method="POST" enctype="multipart/form-data" class="space-y-2">
                        <label class="label" for="csvFile">Berkas CSV <span class="font-medium text-muted">(kolom: Nama, Nomor)</span></label>
                        <input type="file" class="input" id="csvFile" name="csvFile" accept=".csv" required>
                        <button type="submit" class="btn btn-secondary btn-block"><i class="ri-upload-2-line"></i> Impor CSV</button>
                    </form>
                </div>
            </section>
        </aside>

        <section class="card lg:col-span-2" aria-labelledby="contactsTitle">
            <div class="card-head"><h2 class="card-title" id="contactsTitle"><i class="ri-contacts-book-2-line"></i> Daftar kontak</h2></div>
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Nama</th><th>Nomor</th><th>Tag</th><th class="text-right">Aksi</th></tr></thead>
                    <tbody>
                    <% if (contacts.length > 0) { %>
                        <% contacts.forEach(contact => { %>
                        <tr>
                            <td class="font-semibold text-ink"><%= contact.name %></td>
                            <td><code class="code"><%= contact.phone %></code></td>
                            <td>
                                <form action="/contacts/tags/<%= contact.id %>" method="POST" class="flex items-center gap-1">
                                    <input type="text" name="tags" value="<%= contact.tags || '' %>" class="input h-8 w-36 text-[13px]" placeholder="tag" aria-label="Tag <%= contact.name %>">
                                    <button type="submit" class="btn btn-ghost btn-sm btn-icon" aria-label="Simpan tag" data-no-loading><i class="ri-save-line"></i></button>
                                </form>
                            </td>
                            <td class="text-right">
                                <form action="/contacts/delete/<%= contact.id %>" method="POST" data-confirm="Hapus kontak <%= contact.name %>?" class="inline">
                                    <button type="submit" class="btn btn-ghost-danger btn-sm btn-icon" aria-label="Hapus kontak"><i class="ri-delete-bin-line"></i></button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr><td colspan="4" class="empty"><i class="ri-contacts-book-line"></i>Belum ada kontak.</td></tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
            <% if (totalPages > 1) { %>
            <nav class="card-foot" aria-label="Halaman">
                <% if (currentPage > 1) { %><a class="btn btn-ghost btn-sm btn-icon" href="/contacts?page=<%= currentPage - 1 %>" aria-label="Sebelumnya"><i class="ri-arrow-left-s-line"></i></a><% } %>
                <% for (let p = 1; p <= totalPages; p++) { %>
                <a class="btn btn-sm <%= p === currentPage ? 'btn-primary' : 'btn-ghost' %>" href="/contacts?page=<%= p %>" <%- p === currentPage ? 'aria-current="page"' : '' %>><%= p %></a>
                <% } %>
                <% if (currentPage < totalPages) { %><a class="btn btn-ghost btn-sm btn-icon" href="/contacts?page=<%= currentPage + 1 %>" aria-label="Berikutnya"><i class="ri-arrow-right-s-line"></i></a><% } %>
            </nav>
            <% } %>
        </section>
    </div>

<%- include('partials/shell-end') %>
</body>
</html>
