<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Pengaturan' }) %>
</head>
<body>
<%- include('partials/shell-start', { title: 'Pengaturan', page: 'settings' }) %>
<%
    const events = [
        { id: 'toggle_connection', name: 'webhook_toggle_connection', label: 'Status koneksi', hint: 'Terhubung, terputus, QR baru', on: locals.webhookToggleConnection },
        { id: 'toggle_msg_in', name: 'webhook_toggle_message_in', label: 'Pesan masuk', hint: 'Termasuk tombol yang ditekan', on: locals.webhookToggleMessageIn },
        { id: 'toggle_msg_out', name: 'webhook_toggle_message_out', label: 'Pesan keluar', hint: 'Pesan yang dikirim lewat API', on: locals.webhookToggleMessageOut }
    ];
%>

    <div class="page-head">
        <div>
            <h1 class="page-title">Pengaturan</h1>
            <p class="page-sub m-0">Kirim event WhatsApp ke server Anda.</p>
        </div>
        <form action="/settings/webhook/test" method="POST">
            <button type="submit" class="btn btn-secondary"><i class="ri-send-plane-line"></i> Kirim webhook uji</button>
        </form>
    </div>

    <%- include('partials/flash') %>

    <div class="grid gap-4 lg:grid-cols-3">
        <form action="/settings/webhook" method="POST" class="card lg:col-span-2">
            <div class="card-head"><h2 class="card-title"><i class="ri-webhook-line"></i> Webhook</h2></div>
            <div class="card-body space-y-4">
                <div>
                    <label class="label" for="webhook_url">URL webhook</label>
                    <input type="url" id="webhook_url" name="webhook_url" value="<%= locals.webhookUrl || '' %>" placeholder="https://domain-anda.com/webhook" class="input font-mono">
                    <p class="hint">Menerima request POST untuk setiap event yang diaktifkan.</p>
                </div>
                <div>
                    <label class="label" for="webhook_secret">Secret HMAC <span class="font-medium text-muted">(opsional)</span></label>
                    <input type="text" id="webhook_secret" name="webhook_secret" value="<%= locals.webhookSecret || '' %>" placeholder="Kunci untuk verifikasi tanda tangan" class="input font-mono">
                </div>
                <fieldset class="m-0 border-0 p-0">
                    <legend class="label">Event</legend>
                    <div class="divide-y divide-line rounded-md border border-line">
                        <% events.forEach(ev => { %>
                        <label class="flex cursor-pointer items-center justify-between gap-3 px-3 py-2.5" for="<%= ev.id %>">
                            <span>
                                <span class="block text-sm font-semibold text-ink"><%= ev.label %></span>
                                <span class="block text-xs text-muted"><%= ev.hint %></span>
                            </span>
                            <span class="switch"><input type="checkbox" id="<%= ev.id %>" name="<%= ev.name %>" <%= ev.on ? 'checked' : '' %>><span></span></span>
                        </label>
                        <% }) %>
                    </div>
                </fieldset>
            </div>
            <div class="card-foot">
                <button type="submit" class="btn btn-primary"><i class="ri-save-line"></i> Simpan</button>
            </div>
        </form>

        <aside class="space-y-4">
            <section class="card">
                <div class="card-head"><h2 class="card-title"><i class="ri-shield-check-line"></i> Tanda tangan</h2></div>
                <p class="card-body m-0 text-sm text-ink-soft">Jika secret diisi, setiap request membawa header <code class="code">X-Signature</code>: HMAC SHA256 dari body dengan secret tersebut.</p>
            </section>
            <section class="card">
                <div class="card-head"><h2 class="card-title"><i class="ri-repeat-line"></i> Pengiriman ulang</h2></div>
                <p class="card-body m-0 text-sm text-ink-soft">Webhook dikirim ulang hingga 3 kali bila server tidak membalas <code class="code">200 OK</code>.</p>
            </section>
        </aside>
    </div>

<%- include('partials/shell-end') %>
</body>
</html>
