<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Balas Otomatis' }) %>
</head>
<body>
<%- include('partials/shell-start', { title: 'Balas Otomatis', page: 'auto-reply' }) %>
<% const botOn = settings.auto_reply_enabled === 'true'; %>

    <div class="page-head">
        <div>
            <h1 class="page-title">Balas Otomatis</h1>
            <p class="page-sub m-0">Balas pesan berdasarkan kata kunci.</p>
        </div>
        <form action="/auto-reply/settings" method="POST" id="settingsForm" class="flex items-center gap-3 rounded-md border border-line bg-surface px-3 py-2">
            <span class="text-sm font-semibold text-ink">Bot</span>
            <span class="badge <%= botOn ? 'badge-success' : 'badge-neutral' %>"><%= botOn ? 'Aktif' : 'Nonaktif' %></span>
            <label class="switch" aria-label="Aktifkan bot balas otomatis">
                <input type="checkbox" name="auto_reply_enabled" <%= botOn ? 'checked' : '' %> onchange="this.form.submit()">
                <span></span>
            </label>
        </form>
    </div>

    <%- include('partials/flash') %>

    <section class="card mb-4" aria-labelledby="newRuleTitle">
        <div class="card-head"><h2 class="card-title" id="newRuleTitle"><i class="ri-add-box-line"></i> Aturan baru</h2></div>
        <form action="/auto-reply/add" method="POST" class="card-body grid gap-3 md:grid-cols-[1fr_2fr_auto] md:items-end">
            <div>
                <label class="label" for="keyword">Kata kunci</label>
                <input type="text" id="keyword" name="keyword" class="input font-mono" placeholder="info" required>
            </div>
            <div>
                <label class="label" for="reply">Pesan balasan</label>
                <input type="text" id="reply" name="reply" class="input" placeholder="Tulis pesan balasan…" required>
            </div>
            <button type="submit" class="btn btn-primary"><i class="ri-save-line"></i> Simpan</button>
        </form>
    </section>

    <section class="card" aria-labelledby="rulesTitle">
        <div class="card-head">
            <h2 class="card-title" id="rulesTitle"><i class="ri-list-settings-line"></i> Aturan</h2>
            <span class="text-xs text-muted"><%= replies.length %> aturan · klik status untuk mengubah</span>
        </div>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th class="w-28">Status</th><th>Kata kunci</th><th>Balasan</th><th class="text-right">Aksi</th></tr></thead>
                <tbody>
                <% if (replies && replies.length > 0) { %>
                    <% replies.forEach(rule => { %>
                    <tr>
                        <td>
                            <a href="/auto-reply/toggle/<%= rule.id %>" class="badge no-underline <%= rule.enabled ? 'badge-success' : 'badge-neutral' %>" title="Ubah status">
                                <span class="dot <%= rule.enabled ? 'connected' : 'bg-line-strong' %>"></span><%= rule.enabled ? 'Aktif' : 'Nonaktif' %>
                            </a>
                        </td>
                        <td><code class="code"><%= rule.keyword %></code></td>
                        <td class="max-w-md truncate text-ink-soft" title="<%= rule.reply %>"><%= rule.reply %></td>
                        <td class="text-right">
                            <form action="/auto-reply/delete/<%= rule.id %>" method="POST" data-confirm="Hapus aturan “<%= rule.keyword %>”?" class="inline">
                                <button type="submit" class="btn btn-ghost-danger btn-sm btn-icon" aria-label="Hapus aturan"><i class="ri-delete-bin-line"></i></button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="4" class="empty"><i class="ri-chat-off-line"></i>Belum ada aturan. Tambahkan aturan pertama di atas.</td></tr>
                <% } %>
                </tbody>
            </table>
        </div>
    </section>

<%- include('partials/shell-end') %>
</body>
</html>
