<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Kunci API' }) %>
</head>
<body>
<%- include('partials/shell-start', { title: 'Kunci API', page: 'api-keys' }) %>

    <div class="page-head">
        <div>
            <h1 class="page-title">Kunci API</h1>
            <p class="page-sub m-0">Akses terprogram tanpa cookie sesi. <%= keys.length %> kunci aktif.</p>
        </div>
        <form action="/api-keys/generate" method="POST">
            <button type="submit" class="btn btn-primary"><i class="ri-add-line"></i> Buat kunci</button>
        </form>
    </div>

    <%- include('partials/flash') %>

    <div class="grid gap-4 lg:grid-cols-3">
        <section class="card lg:col-span-2" aria-labelledby="keysTitle">
            <div class="card-head">
                <h2 class="card-title" id="keysTitle"><i class="ri-key-2-line"></i> Daftar kunci</h2>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr><th class="w-10">#</th><th>Kunci</th><th>Dibuat</th><th class="text-right">Aksi</th></tr>
                    </thead>
                    <tbody>
                    <% if (keys && keys.length > 0) { %>
                        <% keys.forEach((k, index) => { %>
                        <tr>
                            <td class="text-muted"><%= index + 1 %></td>
                            <td>
                                <% if (k.raw) { %>
                                <div class="flex items-center gap-2">
                                    <code class="code"><%= k.raw %></code>
                                    <button type="button" data-copy="<%= k.raw %>" class="btn btn-ghost btn-sm btn-icon" aria-label="Salin kunci"><i class="ri-file-copy-line"></i></button>
                                </div>
                                <% } else { %>
                                <span class="inline-flex items-center gap-1 text-muted"><i class="ri-lock-line"></i> Tersembunyi</span>
                                <% } %>
                            </td>
                            <td class="whitespace-nowrap text-muted"><%= new Date(k.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                            <td class="text-right">
                                <form action="/api-keys/delete/<%= k.id %>" method="POST" data-confirm="Hapus kunci API ini? Integrasi yang memakainya akan berhenti." class="inline">
                                    <button type="submit" class="btn btn-ghost-danger btn-sm btn-icon" aria-label="Hapus kunci"><i class="ri-delete-bin-line"></i></button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="4" class="empty"><i class="ri-key-2-line"></i>Belum ada kunci API. Klik “Buat kunci” untuk memulai.</td></tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <aside class="flex flex-col gap-4">
            <section class="card">
                <div class="card-head"><h2 class="card-title"><i class="ri-terminal-box-line"></i> Cara pakai</h2></div>
                <div class="card-body space-y-3">
                    <pre class="console">X-API-KEY: kunci_anda</pre>
                    <p class="m-0 text-sm text-ink-soft">Kirim lewat header <code class="code">X-API-KEY</code> atau query <code class="code">?api_key=</code>.</p>
                </div>
            </section>
            <div class="alert alert-warning">
                <i class="ri-shield-keyhole-line mt-0.5"></i>
                <span>Kunci hanya ditampilkan sekali saat dibuat. Simpan di tempat aman.</span>
            </div>
        </aside>
    </div>

<%- include('partials/shell-end') %>
<script>
    document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-copy]');
        if (!btn) return;
        navigator.clipboard.writeText(btn.dataset.copy).then(() => showNotification('Kunci API disalin', 'success'));
    });
</script>
</body>
</html>
